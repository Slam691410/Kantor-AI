# Salin ke .env untuk pengembangan lokal: cp .env.example .env
# Jangan commit .env ke Git.

# PORT: Port server Express (default 3000).
PORT=3000

# DATA_DIR: Folder penyimpanan database JSON (default: data/).
# DATA_DIR=data

# GEMINI_API_KEY: Wajib untuk Asisten AI Gemini (server-side @google/genai).
# Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model Gemini (default: gemini-2.5-flash).
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: URL publik aplikasi (opsional, untuk tautan mandiri).
APP_URL=""

# VITE_GOOGLE_MAPS_API_KEY: Kunci Google Maps Platform JavaScript API.
# Tanpa kunci ini, peta interaktif nonaktif — pengguna tetap bisa
# "Ambil GPS Sekarang" atau "Titik Kantor Pusat".
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# VITE_GOOGLE_MAP_ID: Map ID Google Maps Platform (opsional; Advanced Marker).
# Untuk development dapat dibiarkan kosong (DEMO_MAP_ID).
VITE_GOOGLE_MAP_ID=""

# RESEND_API_KEY & MAIL_FROM: Opsional untuk kirim OTP via email nyata.
# Bila kosong, mode preview aktif (OTP ditampilkan di layar + log server).
RESEND_API_KEY=""
MAIL_FROM="Holding Investasi <onboarding@resend.dev>"
